{
  "name": "@openchat/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The OpenChat iOS app. One app, connected to one installation at a time.",
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --platform ios --no-install",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@openchat/api-client": "workspace:*",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.105.2",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@openchat/notification-protocol": "workspace:*",
    "@openchat/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
