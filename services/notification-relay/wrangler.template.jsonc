{
  // The notification relay. Independent of the installation: see docs/notification-relay/protocol.md.
  // Storage and queues arrive in later Milestone 3 slices.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oc-relay-local",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-30",
  "observability": { "enabled": true },
  "vars": {
    "RELAY_MODE": "private",
    "APNS_ENVIRONMENT": "production"
  },
  "durable_objects": { "bindings": [{ "name": "APNS_CREDENTIAL", "class_name": "ApnsCredential" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApnsCredential"] }],
  // Once a day, so a change in how Workers reach APNs is noticed. See ADR-0006.
  "triggers": { "crons": ["17 4 * * *"] }
}
